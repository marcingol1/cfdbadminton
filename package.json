{
  "name": "deadminton",
  "private": true,
  "version": "0.1.0",
  "description": "Badminton with deadly weapons. Win by points or by KO.",
  "license": "MIT",
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*",
    "tools/*"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "npm run dev -w @deadminton/web",
    "build": "npm run build -w @deadminton/web",
    "preview": "npm run preview -w @deadminton/web",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit -p .",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "simbatch": "npm run start -w @deadminton/simbatch --",
    "check": "npm run lint && npm run format:check && npm run typecheck && npm test",
    "e2e": "npm run e2e -w @deadminton/web"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.56.1",
    "@types/node": "^22.20.5",
    "eslint": "^10.12.0",
    "globals": "^17.13.0",
    "prettier": "^3.9.9",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.1",
    "vite": "^8.3.4",
    "vitest": "^5.0.3"
  }
}
