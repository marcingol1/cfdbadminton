{
  "name": "@deadminton/web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "screenshots": "vite build && tsx e2e/screenshots.ts",
    "e2e": "vite build && playwright test",
    "icons": "tsx scripts/icons.ts && npx -y @capacitor/assets@3.0.5 generate --ios --android --iconBackgroundColor '#181425' --iconBackgroundColorDark '#181425' --splashBackgroundColor '#181425' --splashBackgroundColorDark '#181425'",
    "mobile:sync": "vite build && cap sync",
    "android": "npm run mobile:sync && cap open android",
    "ios": "npm run mobile:sync && cap open ios",
    "android:apk": "npm run mobile:sync && cd android && ./gradlew assembleDebug"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.3",
    "@capacitor/app": "^8.1.2",
    "@capacitor/core": "^8.5.3",
    "@capacitor/haptics": "^8.0.2",
    "@capacitor/ios": "^8.5.3",
    "@capacitor/screen-orientation": "^8.0.2",
    "@capacitor/splash-screen": "^8.0.2",
    "@capacitor/status-bar": "^8.0.4",
    "@deadminton/bots": "0.1.0",
    "@deadminton/sim": "0.1.0",
    "@fontsource/press-start-2p": "^5.3.0",
    "phaser": "^4.2.1"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.3"
  }
}
